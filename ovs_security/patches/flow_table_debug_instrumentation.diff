+/* Keep this wrapper out-of-line so perf can attribute backend hash cost. */
+static noinline u32 ovs_flow_hash_backend(const void *hash_data,
+					  size_t hash_len)
+{
+#if OVS_FLOW_HASH_DEBUG_LEN
+	/* 每次呼叫累加 masked-key 長度直方圖;讀取/歸零經 debugfs ovs_hashlen。 */
+	if (hash_len < OVS_HASHLEN_MAX)
+		atomic64_inc(&ovs_hash_hist[hash_len]);
+	else
+		atomic64_inc(&ovs_hash_over);
+	atomic64_inc(&ovs_hash_calls);
+#endif
 #if OVS_FLOW_HASH_JHASH
-	return jhash2(hash_key, hash_u32s, 0);
+	return jhash2((const u32 *)hash_data, (u32)(hash_len >> 2), 0);
 #elif OVS_FLOW_HASH_HSIPHASH
-#error "OVS_FLOW_HASH_HSIPHASH is not implemented yet"
+	return hsiphash(hash_data, hash_len, &ovs_flow_hsiphash_key);
 #elif OVS_FLOW_HASH_SIPHASH
-#error "OVS_FLOW_HASH_SIPHASH is not implemented yet"
+	{
+		u64 h = siphash(hash_data, hash_len, &ovs_flow_siphash_key);
+
+		/* flow_hash() returns u32, so fold SipHash's 64-bit output. */
+		return (u32)(h ^ (h >> 32));
+	}
 #else
 #error "No OVS flow hash backend selected"
 #endif
 }
 
+static u32 flow_hash(const struct sw_flow_key *key,
+		     const struct sw_flow_key_range *range)
+{
+	const void *hash_data = (const u8 *)key + range->start;
+
+	return ovs_flow_hash_backend(hash_data, range_n_bytes(range));
+}
