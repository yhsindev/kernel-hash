+
+#if OVS_FLOW_HASH_DEBUG_LEN
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
+
+/* masked-key length(range_n_bytes)直方圖:file-scope state,供 debugfs 讀取/歸零。
+ * hash_len 0..OVS_HASHLEN_MAX-1 各一格,超出者計入 ovs_hash_over(避免靜默漏計);
+ * 每次 ovs_flow_hash_backend() 呼叫累加。conntrack flow 的 range 會延伸到 sw_flow_key
+ * 尾端的 ct 區,長度可達 ~200+ bytes,故上界放寬到 512 足以涵蓋整把 key。 */
+#define OVS_HASHLEN_MAX 512
+static atomic64_t ovs_hash_hist[OVS_HASHLEN_MAX];
+static atomic64_t ovs_hash_over;	/* hash_len >= OVS_HASHLEN_MAX 的計數 */
+static atomic64_t ovs_hash_calls;
+static struct dentry *ovs_hashlen_dentry;
+
+static int ovs_hashlen_show(struct seq_file *m, void *v)
+{
+	s64 total = atomic64_read(&ovs_hash_calls);
+	s64 over = atomic64_read(&ovs_hash_over);
+	int i;
+
+	seq_puts(m, "# ovs_flow_hash_backend masked-key length histogram\n");
+	seq_printf(m, "# total_calls %lld\n", total);
+	seq_printf(m, "# overflow(>=%d) %lld\n", OVS_HASHLEN_MAX, over);
+	seq_puts(m, "# hash_len count\n");
+	for (i = 0; i < OVS_HASHLEN_MAX; i++) {
+		s64 c = atomic64_read(&ovs_hash_hist[i]);
+
+		if (c)
+			seq_printf(m, "%d %lld\n", i, c);
+	}
+	return 0;
+}
+
+static int ovs_hashlen_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, ovs_hashlen_show, NULL);
+}
+
+/* 任何寫入都將直方圖與呼叫計數歸零(灌測試流量前清乾淨用)。 */
+static ssize_t ovs_hashlen_write(struct file *file, const char __user *buf,
+				 size_t count, loff_t *ppos)
+{
+	int i;
+
+	for (i = 0; i < OVS_HASHLEN_MAX; i++)
+		atomic64_set(&ovs_hash_hist[i], 0);
+	atomic64_set(&ovs_hash_over, 0);
+	atomic64_set(&ovs_hash_calls, 0);
+	return count;
+}
+
+static const struct file_operations ovs_hashlen_fops = {
+	.owner   = THIS_MODULE,
+	.open    = ovs_hashlen_open,
+	.read    = seq_read,
+	.llseek  = seq_lseek,
+	.release = single_release,
+	.write   = ovs_hashlen_write,
+};
+
+/* 實驗三:lookup probe-count 直方圖。每次 masked_flow_lookup() 走過的 hlist 節點數
+ * 計一筆(空 bucket=0,命中於第 n 個=n,未命中=整條 chain 長度),反映 flow_hash 的
