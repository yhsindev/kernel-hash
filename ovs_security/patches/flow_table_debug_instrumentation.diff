+	int i;
 
-	/* Make sure number of hash bytes are multiple of u32. */
-	int hash_u32s = range_n_bytes(range) >> 2;
+	seq_puts(m, "# masked_flow_lookup probe-count histogram\n");
+	seq_printf(m, "# total_lookups %lld\n", total);
+	seq_printf(m, "# overflow(>=%d) %lld\n", OVS_PROBELEN_MAX, over);
+	seq_puts(m, "# probes count\n");
+	for (i = 0; i < OVS_PROBELEN_MAX; i++) {
+		s64 c = atomic64_read(&ovs_probe_hist[i]);
 
+		if (c)
+			seq_printf(m, "%d %lld\n", i, c);
+	}
+	return 0;
+}
+
+static int ovs_probelen_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, ovs_probelen_show, NULL);
+}
+
+static ssize_t ovs_probelen_write(struct file *file, const char __user *buf,
+				  size_t count, loff_t *ppos)
+{
+	int i;
+
+	for (i = 0; i < OVS_PROBELEN_MAX; i++)
+		atomic64_set(&ovs_probe_hist[i], 0);
+	atomic64_set(&ovs_probe_over, 0);
+	atomic64_set(&ovs_probe_calls, 0);
+	return count;
+}
+
+static const struct file_operations ovs_probelen_fops = {
+	.owner   = THIS_MODULE,
+	.open    = ovs_probelen_open,
+	.read    = seq_read,
+	.llseek  = seq_lseek,
+	.release = single_release,
+	.write   = ovs_probelen_write,
+};
+#endif /* OVS_FLOW_HASH_DEBUG_LEN */
