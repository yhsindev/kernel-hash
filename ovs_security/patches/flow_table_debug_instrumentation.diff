+ * 讀取/歸零經 debugfs /sys/kernel/debug/ovs_probelen。 */
+#define OVS_PROBELEN_MAX 1024
+static atomic64_t ovs_probe_hist[OVS_PROBELEN_MAX];
+static atomic64_t ovs_probe_over;
+static atomic64_t ovs_probe_calls;
+static struct dentry *ovs_probelen_dentry;
+
+static void ovs_record_probe(unsigned int probes)
+{
+	if (probes < OVS_PROBELEN_MAX)
+		atomic64_inc(&ovs_probe_hist[probes]);
+	else
+		atomic64_inc(&ovs_probe_over);
+	atomic64_inc(&ovs_probe_calls);
+}
+
+static int ovs_probelen_show(struct seq_file *m, void *v)
 {
-	const u32 *hash_key = (const u32 *)((const u8 *)key + range->start);
+	s64 total = atomic64_read(&ovs_probe_calls);
