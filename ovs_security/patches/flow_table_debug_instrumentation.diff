+/* 實驗三 Part 3:OVS flow table 的 bucket-load snapshot。
+ * 按需(cat /sys/kernel/debug/ovs_buckets)走當前 table_instance 的 buckets,
+ * 算 chain-length 分布 / Lmax / collisions(對應 Part 2 的 L_b/Lmax/C,但在真實 OVS 表上)。
+ * ovs_dbg_tbl 由 ovs_flow_tbl_init/destroy 維護(單一 datapath 的 testbed 一個全域指標足夠)。
+ * RCU-safe:rcu_read_lock 下只「累積」進本地直方圖,解鎖後才 seq_printf。
+ * (ovs_dbg_tbl 宣告在檔案頂端,因 ovs_flow_tbl_init 在 OVS_FLOW_HASH_DEBUG_LEN 巨集之前。) */
+#define OVS_BUCKETHIST_MAX 128
+static struct dentry *ovs_buckets_dentry;
+
+static int ovs_buckets_show(struct seq_file *m, void *v)
+{
+	struct flow_table *tbl = READ_ONCE(ovs_dbg_tbl);
+	struct table_instance *ti;
+	u64 *hist;	/* [0..127] + overflow 於 [128];heap 配置避免大 stack frame */
+	u64 collisions = 0, total = 0;
+	u32 nb = 0, Lmax = 0, nonempty = 0;
+	int i;
+
+	if (!tbl) {
+		seq_puts(m, "# no flow table registered\n");
+		return 0;
+	}
+	hist = kcalloc(OVS_BUCKETHIST_MAX + 1, sizeof(*hist), GFP_KERNEL);
+	if (!hist)
+		return -ENOMEM;
+
+	rcu_read_lock();
+	ti = rcu_dereference(tbl->ti);
+	if (ti) {
+		nb = ti->n_buckets;
+		for (i = 0; i < (int)nb; i++) {
+			struct hlist_head *head = &ti->buckets[i];
+			struct sw_flow *f;
+			u32 L = 0;
+
+			hlist_for_each_entry_rcu(f, head,
+						 flow_table.node[ti->node_ver])
+				L++;
+			if (L) {
+				nonempty++;
+				total += L;
+				collisions += (u64)L * (L - 1) / 2;
+				if (L > Lmax)
+					Lmax = L;
+			}
+			if (L <= OVS_BUCKETHIST_MAX)
+				hist[L]++;
+			else
+				hist[OVS_BUCKETHIST_MAX]++;
+		}
+	}
+	rcu_read_unlock();
+
+	seq_puts(m, "# ovs flow-table bucket-load snapshot\n");
+	seq_printf(m, "# n_buckets %u total_flows %llu Lmax %u nonempty %u collisions %llu\n",
+		   nb, total, Lmax, nonempty, collisions);
+	seq_puts(m, "# chain_len buckets\n");
+	for (i = 0; i <= OVS_BUCKETHIST_MAX; i++)
+		if (hist[i])
+			seq_printf(m, "%d %llu\n", i, hist[i]);
+	kfree(hist);
+	return 0;
+}
